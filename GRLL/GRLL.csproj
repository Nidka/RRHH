      <HintPath>..\lib\legacy\Custom Featured MessageBox.dll</HintPath>
    </Reference>
    <Reference Include="GRLL.Common.Rutinas">
      <HintPath>..\lib\legacy\GRLL.Common.Rutinas.dll</HintPath>
