# Copiar a .env en la raíz. Guardar la conexión real solo en el entorno.
RRHH_WEB_POSTGRES=

# Production para un servidor detrás de HTTPS. Development solo para QA local.
RRHH_WEB_ENVIRONMENT=Production
RRHH_WEB_PORT=8080

# IDs existentes en la base destino. Operadores y autoconsulta son disjuntos.
RRHH_WEB_ROLES=
RRHH_WEB_ROLES_AUTOCONSULTA=
RRHH_WEB_ROLES_AUSENCIAS=
RRHH_WEB_ROLES_HORARIOS=
RRHH_WEB_ROLES_MOTIVOS=
RRHH_WEB_ROLES_ASISTENCIA=
RRHH_WEB_ROLES_VACACIONES=
RRHH_WEB_ROLES_PERMISOS=
RRHH_VACACIONES_DIAS_ANUALES=30
