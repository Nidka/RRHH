# Copie este archivo como .env y complete los valores locales.
# .env está excluido de Git; nunca confirme contraseñas reales.
DB_HOST=localhost
DB_PORT=5432
DB_USER=rrhh_app
DB_PASSWORD=CAMBIAR
DB_NAME=CMI
DB_SSLMODE=require
DB_CHANNEL_BINDING=require

# Piloto académico: listas vacías deshabilitan los nuevos módulos de escritorio.
# Configurar IDs reales de roles revisados por el equipo. La demo usa operador 10 y empleado 20.
RRHH_VACACIONES_DIAS_ANUALES=30
RRHH_VACACIONES_ROLES=
RRHH_PERMISOS_ROLES=
RRHH_ASISTENCIA_ROLES=
RRHH_AUTOCONSULTA_ROLES=
RRHH_SOLO_AUTOCONSULTA=0

# En web configurar además RRHH_WEB_POSTGRES y las políticas del README del host.
# RRHH_WEB_ROLES_AUTOCONSULTA debe ser disjunto de RRHH_WEB_ROLES (operadores).
# No habilitar permisos operativos para el rol de empleado.
