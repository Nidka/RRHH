# Variables del host web de RRHH. Configúrelas en el panel de la plataforma (Render, etc.); no las suba a Git.
# La cadena de conexión de Neon es un secreto: tratarla como una contraseña.

# --- Obligatorias ---
# Formato Npgsql. En Neon: copiar host, base, usuario y clave del panel y agregar SSL Mode=Require.
RRHH_WEB_POSTGRES=Host=ep-XXXX.sa-east-1.aws.neon.tech;Port=5432;Database=neondb;Username=USUARIO;Password=CLAVE;SSL Mode=Require;Trust Server Certificate=true
# IDs de rol (Usuario_Rol.IdRol) autorizados como operadores de RRHH, separados por comas.
RRHH_WEB_ROLES=10

# --- Módulos (lista vacía = módulo deshabilitado; los roles deben estar también en RRHH_WEB_ROLES) ---
RRHH_WEB_ROLES_AUSENCIAS=10
RRHH_WEB_ROLES_HORARIOS=10
RRHH_WEB_ROLES_MOTIVOS=10
RRHH_WEB_ROLES_ASISTENCIA=10
RRHH_WEB_ROLES_VACACIONES=10
RRHH_WEB_ROLES_PERMISOS=10
# CR-020: registro y edición de empleados.
RRHH_WEB_ROLES_PERSONAL=10
# Autoconsulta del empleado: roles DISTINTOS de los de operador.
RRHH_WEB_ROLES_AUTOCONSULTA=
RRHH_VACACIONES_DIAS_ANUALES=30

# --- Plataforma ---
ASPNETCORE_ENVIRONMENT=Production
# true SOLO detrás del proxy de la plataforma (Render lo es). Nunca en un contenedor expuesto directamente.
RRHH_WEB_TRUST_PROXY=true
